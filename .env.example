SYMBOL=GOLD
DRY_RUN=true
RISK_PERCENT=0.5
POLL_SECONDS=60
M5_BARS=300
H1_BARS=300
PIP_SIZE=0.1
ENFORCE_MIN_STOP=true

# Broker selection: mock | mt5 | metaapi | auto (overrides config/default.json)
# "auto" = mt5 on Windows, metaapi on macOS/Linux — same npm start everywhere
# BROKER_MODE=auto

# MetaApi (metaapi.cloud) — live/demo MT5 without Windows.
# Sign up, add your MT5 account in their dashboard, then fill these in:
# METAAPI_TOKEN=your-token
# METAAPI_ACCOUNT_ID=your-account-id

# Telegram alerts — secrets live HERE (gitignored), not in config/default.json
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Dashboard: bind address override and Basic Auth password.
# Set DASHBOARD_HOST=0.0.0.0 on a VPS to allow remote access, and ALWAYS set a
# password when doing so. Empty/missing password = no login prompt.
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PASSWORD=pick-a-long-password
