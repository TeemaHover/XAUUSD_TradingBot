SYMBOL=GOLD
DRY_RUN=true
RISK_PERCENT=0.5
POLL_SECONDS=60
M5_BARS=300
H1_BARS=300
PIP_SIZE=0.1
ENFORCE_MIN_STOP=true

# Broker selection: mock | mt5 | metaapi | auto (overrides config/default.json)
# "auto" = mt5 on Windows, metaapi on macOS/Linux — same npm start everywhere
# BROKER_MODE=auto

# MetaApi (metaapi.cloud) — live/demo MT5 without Windows.
# Sign up, add your MT5 account in their dashboard, then fill these in:
# METAAPI_TOKEN=your-token
# METAAPI_ACCOUNT_ID=your-account-id
