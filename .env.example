SYMBOL=GOLD
DRY_RUN=true
RISK_PERCENT=0.5
POLL_SECONDS=60
M5_BARS=300
H1_BARS=300
STARTUP_ORDER_ENABLED=false
STARTUP_ORDER_SIDE=BUY
STARTUP_SL_PIPS=5
STARTUP_TP_PIPS=5
PIP_SIZE=0.1
ENFORCE_MIN_STOP=true

# Broker selection: mock | mt5 | metaapi (overrides config/default.json)
# BROKER_MODE=metaapi

# MetaApi (metaapi.cloud) — live/demo MT5 without Windows.
# Sign up, add your MT5 account in their dashboard, then fill these in:
# METAAPI_TOKEN=your-token
# METAAPI_ACCOUNT_ID=your-account-id
